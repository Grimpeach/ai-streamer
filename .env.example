# Скопируйте в .env и заполните. Вложенные секции — через двойное подчёркивание.

LOG_LEVEL=INFO
DEMO_MODE=false

# --- Twitch (только чтение чата, нужен scope chat:read) ---
# Токен можно взять на https://twitchapps.com/tmi/ — префикс oauth: необязателен.
TWITCH_CHANNEL=
TWITCH_TOKEN=
# Полные (вложенные) имена тоже работают и имеют приоритет:
# TWITCH__CHANNEL=
# TWITCH__ACCESS_TOKEN=
# TWITCH__CHAT_TTL_S=45
# TWITCH__IGNORE_COMMANDS=true

# --- Push-to-Talk (абсолютный приоритет, мгновенно глушит LLM/TTS) ---
# На Windows глобальный хук keyboard требует запуска от администратора.
PTT__HOTKEY=f13
PTT__SAMPLE_RATE=16000
# PTT__INPUT_DEVICE=   # индекс или имя из sounddevice.query_devices()

# --- STT: Faster-Whisper (~1 ГБ VRAM). Первый запуск скачивает веса. ---
STT__MODEL=large-v3-turbo
STT__DEVICE=cuda
# language — подсказка языка речи; пусто = авто. task=translate всегда отдаёт английский.
STT__LANGUAGE=
STT__TASK=translate

# --- LLM: vLLM (WSL2) или llama.cpp server ---
LLM__BASE_URL=http://127.0.0.1:8000/v1
LLM__MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
LLM__MAX_TOKENS=220

# --- STT / TTS ---
STT__MODEL=large-v3-turbo
TTS__ENGINE=kokoro
TTS__VOICE=ru_female_1

# --- Память ---
MEMORY__REDIS_URL=redis://127.0.0.1:6379/0
MEMORY__QDRANT_URL=http://127.0.0.1:6333

# --- Бюджет VRAM (RTX 4080 16GB) ---
VRAM__TOTAL_BUDGET_GB=15.0
VRAM__RESERVED_GB=2.5
